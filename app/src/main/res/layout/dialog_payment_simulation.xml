<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPaymentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simulación de Pago"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/green_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvPaymentMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Este evento requiere un pago o donativo."
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvRequiredAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total a pagar: $500.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingresa monto a pagar"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:prefixText="$"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Pagar e Inscribirme"
        android:backgroundTint="@color/green_primary"
        app:cornerRadius="8dp"/>

</LinearLayout>