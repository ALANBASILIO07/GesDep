<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_background_color">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:elevation="0dp"
            android:background="@color/green_primary"> <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="GESDEP - Organizador"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/white"/>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/green_primary"
                    app:cardElevation="4dp">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/ic_trophy"
                        app:tint="#33FFFFFF"
                        android:layout_gravity="end|bottom"
                        android:translationX="20dp"
                        android:translationY="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/tvWelcome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¡Hola, Organizador!"
                            android:textSize="22sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Panel de administración de eventos"
                            android:textSize="14sp"
                            android:textColor="#E0E0E0"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardEvents"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/blue_button" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Gestionar\nEventos" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCreateEvent"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_check"
                                app:tint="@color/green_primary" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Crear\nEvento" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMyEvents"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_sports"
                                app:tint="@color/purple_participants" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Mis\nEventos" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardParticipants"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_group"
                                app:tint="@color/purple_participants" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Lista de\nParticipantes" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCoaches"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_person"
                                app:tint="@color/orange_coach" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Directorio\nEntrenadores" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardReports"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_tools"
                                app:tint="@color/teal_maintenance" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Reportes y\nMantenimiento" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSettings"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_settings"
                                app:tint="@color/text_primary_color" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Ajustes\nGenerales" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLogout"
                        style="@style/DashboardCardStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <LinearLayout style="@style/DashboardContainerStyle">
                            <ImageView
                                style="@style/DashboardIconStyle"
                                android:src="@drawable/ic_logout"
                                app:tint="@color/red_error" />
                            <TextView
                                style="@style/DashboardTextStyle"
                                android:text="Cerrar\nSesión"
                                android:textColor="@color/red_error"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@color/card_surface_color"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_admin"
        app:itemIconTint="@color/icon_tint_color"
        app:itemTextColor="@color/text_primary_color"/>

</androidx.drawerlayout.widget.DrawerLayout>