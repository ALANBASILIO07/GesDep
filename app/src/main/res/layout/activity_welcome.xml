<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/gray_light"
    android:padding="24dp">

    <!-- Logo Container -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/circle_background">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_trophy"
            android:contentDescription="Logo GESDEP" />
    </FrameLayout>

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GESDEP"
        android:textSize="36sp"
        android:textColor="@color/green_primary"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión Deportiva Municipal"
        android:textSize="16sp"
        android:textColor="@color/gray_text"
        android:layout_marginBottom="16dp" />

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Administra y participa en eventos\ndeportivos y culturales"
        android:textSize="14sp"
        android:textColor="@color/gray_dark"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <!-- Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="INICIAR SESIÓN"
        android:textSize="16sp"
        android:textColor="@color/white"
        app:backgroundTint="@color/blue_button"
        app:cornerRadius="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Register Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CREAR CUENTA"
        android:textSize="16sp"
        android:textColor="@color/green_primary"
        app:backgroundTint="@color/white"
        app:strokeColor="@color/green_primary"
        app:strokeWidth="2dp"
        app:cornerRadius="8dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IMCUFIDE - Instituto Municipal de\nCultura Física y Deporte"
        android:textSize="12sp"
        android:textColor="@color/gray_text"
        android:textAlignment="center"
        android:layout_marginTop="32dp" />

</LinearLayout>
